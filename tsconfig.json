{
  "compilerOptions": {
    "target": "ES2017",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-e2e-instances/types/**/*.ts",
    ".next-e2e-mobile/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-review/types/**/*.ts",
    ".next-review2/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-review3/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
