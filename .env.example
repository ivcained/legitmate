# Live Graph provider access (server-only; required for Graph prize qualification)
GRAPH_API_KEY=
GRAPH_SUBGRAPH_ID=

# Privy client app ID is safe to expose to the browser.
NEXT_PUBLIC_PRIVY_APP_ID=

# Privy wallet funding/withdrawal guards. These are public client configuration only.
NEXT_PUBLIC_PRIVY_CHAIN_ID=
NEXT_PUBLIC_PRIVY_FUNDING_ASSET=
# Set to production explicitly to enable fiat funding. sandbox stays disabled.
NEXT_PUBLIC_PRIVY_FUNDING_ENVIRONMENT=
# Fixed recipient only; never expose an arbitrary recipient input in the UI.
NEXT_PUBLIC_PRIVY_WITHDRAW_RECIPIENT=


# Agent37 server credential; never expose this as NEXT_PUBLIC_*.
AGENT37_API_KEY=

# Demo mode remains available without optional provider credentials.
NEXT_PUBLIC_DEMO_MODE=true
