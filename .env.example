# Live Graph provider access (server-only; required for Graph prize qualification)
GRAPH_API_KEY=
GRAPH_SUBGRAPH_ID=

# Privy client app ID is safe to expose to the browser.
NEXT_PUBLIC_PRIVY_APP_ID=

# Privy server credential; never expose this as NEXT_PUBLIC_*.
PRIVY_APP_SECRET=

# Agent37 server credential; never expose this as NEXT_PUBLIC_*.
AGENT37_API_KEY=

# Demo mode remains available without optional provider credentials.
NEXT_PUBLIC_DEMO_MODE=true
